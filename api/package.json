{
  "name": "api",
  "private": true,
  "version": "1.0.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "node --watch src/server.ts",
    "typecheck": "tsc",
    "build": "tsc --noEmit false",
    "test": "node --env-file=./.env.test --test \"test/**/*.test.ts\"",
    "test:db": "docker compose --profile test up -d --wait db-test && docker compose run --rm --no-deps -e DATABASE_URL=postgres://test:test@db-test:5432/test?sslmode=disable migrate",
    "test:db:down": "docker compose --profile test rm -sf db-test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/StefBisti/palimpsa.git"
  },
  "keywords": [],
  "author": "Stefan Bisti",
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/StefBisti/palimpsa/issues"
  },
  "homepage": "https://github.com/StefBisti/palimpsa#readme",
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/rate-limit": "^11.2.1",
    "argon2": "^0.45.1",
    "fastify": "^5.12.7",
    "jose": "^6.2.13",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2"
  }
}
